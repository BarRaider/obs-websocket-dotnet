<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<AssemblyName>obs-websocket-dotnet</AssemblyName>
		<RootNamespace>OBSWebsocketDotNet</RootNamespace>
		<Copyright>Copyright © BarRaider 2025</Copyright>
		<LangVersion>8</LangVersion>
		<Version>5.0.2</Version>
		<Authors>BarRaider</Authors>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/BarRaider/obs-websocket-dotnet</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BarRaider/obs-websocket-dotnet</RepositoryUrl>
		<Description>Official obs-websocket .NET library. Written in C#. Supports .NET Standard 2.1 and .NET 10.</Description>
		<PackageTags>OBS obs-websocket websocket official obs-websocket-dotnet obs.websocket.net obs-websocket-net netstandard2.1 net10</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReleaseNotes>What's new in v5.0.2
* Multi-target netstandard2.1 and net10.0
* Bump Microsoft.Extensions.Logging.Abstractions to 10.0.12
* Bump Newtonsoft.Json to 13.0.4

</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DocumentationFile>obs-websocket-dotnet.xml</DocumentationFile>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="Websocket.Client" Version="5.1.2" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath></PackagePath>
	  </None>
	</ItemGroup>

</Project>